<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="site-header__brand" href="/">{{ "site.title" | t(lang) }}</a>
      {% if showLangSwitch %}
        {% include "lang-switch.njk" %}
      {% endif %}
    </div>
  </header>

  <main class="article">
    <div class="container">
      <div class="article-layout">
        <div class="article-container">
          {{ content | safe }}
        </div>
        <aside class="article-toc" aria-label="{{ 'article.tocLabel' | t(lang) }}">
          <nav class="article-toc__nav">
            <p class="article-toc__title">{{ "article.tocTitle" | t(lang) }}</p>
            <ol class="article-toc__list"></ol>
          </nav>
        </aside>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      © {{ year }} {{ "site.title" | t(lang) }}
    </div>
  </footer>
  <script src="/assets/article-toc.js" defer></script>
</body>
</html>
