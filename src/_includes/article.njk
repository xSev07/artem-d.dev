---
layout: base.njk
mainClass: article
extraHead: head-article.njk
extraScripts: scripts-article.njk
---
<div class="article-layout">
  <div class="article-container">
    {{ content | safe }}
  </div>
  <aside class="article-toc" aria-label="{{ 'article.tocLabel' | t(lang) }}">
    <nav class="article-toc__nav">
      <p class="article-toc__title">{{ "article.tocTitle" | t(lang) }}</p>
      <ol class="article-toc__list"></ol>
    </nav>
  </aside>
</div>
