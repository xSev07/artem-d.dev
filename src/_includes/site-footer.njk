<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__column site-footer__column--brand">
      <p class="site-footer__brand">{{ "site.title" | t(lang) }}</p>
      <p class="site-footer__copyright">© {{ year }} {{ "site.title" | t(lang) }}</p>
    </div>
    <nav class="site-footer__column" aria-label="{{ 'site.footer.guides' | t(lang) }}">
      <p class="site-footer__heading">{{ "site.footer.guides" | t(lang) }}</p>
      <ul class="site-footer__links">
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/articles/guide/">{{ "site.nav.guide" | t(lang) }}</a>
        </li>
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/articles/report-funds-movement/">{{ "apps.sixJarsFinance.articles.reportFundsMovement.title" | t(lang) }}</a>
        </li>
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/articles/report-spendings-by-tags/">{{ "apps.sixJarsFinance.articles.reportSpendingsByTags.title" | t(lang) }}</a>
        </li>
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/articles/report-tag-details/">{{ "apps.sixJarsFinance.articles.reportTagDetails.title" | t(lang) }}</a>
        </li>
      </ul>
    </nav>
    <nav class="site-footer__column" aria-label="{{ 'site.footer.information' | t(lang) }}">
      <p class="site-footer__heading">{{ "site.footer.information" | t(lang) }}</p>
      <ul class="site-footer__links">
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/help/">{{ "common.pages.help" | t(lang) }}</a>
        </li>
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/privacy/">{{ "common.pages.privacy" | t(lang) }}</a>
        </li>
        <li>
          <a class="site-footer__link" href="/{{ lang }}/apps/6-jars-finance/licenses/">{{ "common.pages.licenses" | t(lang) }}</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
