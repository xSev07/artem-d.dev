<nav class="lang-switch" aria-label="{{ 'common.langSwitch.label' | t(lang) }}">
  {% for language in languages %}
    {% if lang == language.code %}
      <span class="lang-switch__current" aria-current="true">{{ ("common.langSwitch." ~ language.code) | t(lang) }}</span>
    {% else %}
      <a class="lang-switch__link" href="/{{ language.code }}{{ langSwitchPath }}">{{ ("common.langSwitch." ~ language.code) | t(lang) }}</a>
    {% endif %}
  {% endfor %}
</nav>
