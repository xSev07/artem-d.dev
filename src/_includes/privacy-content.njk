{% set p = "apps.sixJarsFinance.privacy" %}
{% set s = p ~ ".sections" %}

<h1>{{ "common.pages.privacy" | t(lang) }}</h1>

<p><strong>{{ "common.labels.lastUpdated" | t(lang) }}</strong> {{ (p ~ ".lastUpdated") | t(lang) }}</p>
<p><strong>{{ "common.labels.developer" | t(lang) }}</strong> {{ "site.developer" | t(lang) }}</p>
<p><strong>{{ "common.labels.contactAddress" | t(lang) }}</strong> <a href="mailto:{{ 'site.contactEmail' | t(lang) }}">{{ "site.contactEmail" | t(lang) }}</a></p>

<h2>{{ (s ~ ".general.title") | t(lang) }}</h2>
{% for paragraph in (s ~ ".general.paragraphs") | t(lang) %}
<p>{{ paragraph }}</p>
{% endfor %}

<h2>{{ (s ~ ".dataProcessed.title") | t(lang) }}</h2>

<h2>{{ (s ~ ".userData.title") | t(lang) }}</h2>
<p>{{ (s ~ ".userData.intro") | t(lang) }}</p>
<ul>
  {% for item in (s ~ ".userData.items") | t(lang) %}
  <li>{{ item }}</li>
  {% endfor %}
</ul>
<p>{{ (s ~ ".userData.outro") | t(lang) }}</p>

