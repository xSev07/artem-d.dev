<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body>
  <div class="container">

    <header>
      <div class="site-title">{{ "site.title" | t(lang) }}</div>
      {% if showLangSwitch %}
        {% include "lang-switch.njk" %}
      {% endif %}
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      © {{ year }} {{ "site.title" | t(lang) }}
    </footer>

  </div>
</body>
</html>
