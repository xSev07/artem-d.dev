---
layout: article.njk
pagination:
  data: languages
  size: 1
  alias: pageLang
permalink: "/{{ pageLang.code }}/apps/6-jars-finance/articles/guide/"
showLangSwitch: true
langSwitchPath: "/apps/6-jars-finance/articles/guide/"
year: 2026
eleventyComputed:
  title: "{{ 'apps.sixJarsFinance.articles.guide.title' | t(pageLang.code) }}"
  description: "{{ 'apps.sixJarsFinance.articles.guide.metaDescription' | t(pageLang.code) }}"
  lang: "{{ pageLang.code }}"
---

{% set langCode = pageLang.code %}
{% set article = "apps.sixJarsFinance.articles.guide" | t(langCode) %}

{% macro paragraphs(items) %}
{% for item in items %}
<p>{{ item | safe }}</p>
{% endfor %}
{% endmacro %}

{% macro list(items) %}
<ul>
  {% for item in items %}
  <li>{{ item | safe }}</li>
  {% endfor %}
</ul>
{% endmacro %}

<h1>{{ article.title }}</h1>
{{ paragraphs(article.intro.paragraphs) }}

