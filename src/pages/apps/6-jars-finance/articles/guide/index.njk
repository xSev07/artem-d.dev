  <ol>
    <li><a href="#managing-money">{{ article.overview.managingMoney }}</a></li>
    <li><a href="#how-it-works">{{ article.overview.howItWorks }}</a></li>
    <li><a href="#adjust-percents">{{ article.overview.adjustPercents }}</a></li>
