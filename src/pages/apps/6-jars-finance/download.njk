---
layout: base.njk
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "/{{ lang.code }}/apps/6-jars-finance/download/"
showLangSwitch: true
langSwitchPath: "/apps/6-jars-finance/download/"
year: 2026
eleventyComputed:
  title: "{{ 'apps.sixJarsFinance.download.title' | t(lang.code) }}"
  description: "{{ 'apps.sixJarsFinance.download.metaDescription' | t(lang.code) }}"
  lang: "{{ lang.code }}"
---

{% set d = "apps.sixJarsFinance.download" %}
{% set waitlistSubscribeButton = (d ~ ".modal.waitlist.subscribeButton") | t(lang) %}
{% set screenshotsPath = "articles/six-jars/screenshots" %}
{% set playStoreUrl = "https://play.google.com/store/apps/details?id=com.artemd.jars_finance&utm_source=artem-d.dev&utm_campaign=website" %}

<section class="hero landing-section">
  <div class="hero__card">
    <div class="hero__grid">
      <div class="hero__content">
        <h1 class="hero__title">{{ (d ~ ".hero.title") | t(lang) }}</h1>
        <p class="hero__lead">{{ (d ~ ".hero.lead") | t(lang) }}</p>
        <div class="hero__actions">
          <a
            class="button-store"
            href="{{ playStoreUrl }}"
            rel="noopener noreferrer"
            target="_blank"
            data-analytics-store="google_play"
            data-analytics-placement="hero"
          >
            <svg class="button-store__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M3.609 1.814L13.792 12 3.61 22.186a1.2 1.2 0 0 1-.2-.65V2.465a1.2 1.2 0 0 1 .199-.651z"/>
            </svg>
            Google Play
          </a>
          <button
            class="button-store"
            type="button"
            data-open-app-store-modal
            data-analytics-store="app_store"
            data-analytics-placement="hero"
          >
            <svg class="button-store__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
            </svg>
            App Store
          </button>
        </div>
      </div>
      <div class="hero__preview hero__preview--phone">
        <img
          class="hero__screenshot"
          src="{{ lang | localizedScreenshot(screenshotsPath, 'main-screen.jpg') }}"
          alt="{{ (d ~ '.hero.screenshotAlt') | t(lang) }}"
          width="1080"
          height="2265"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<section class="landing-section">
  <div class="benefits-grid">
    {% for benefit in (d ~ ".benefits") | t(lang) %}
    <div class="card benefit-card">
      <h2 class="benefit-card__title">{{ benefit.title }}</h2>
      <p class="benefit-card__text">{{ benefit.text }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="landing-section">
  <div class="text-section content-column">
    <h2 class="text-section__title">{{ (d ~ ".about.title") | t(lang) }}</h2>
    {% for paragraph in (d ~ ".about.paragraphs") | t(lang) %}
    <p class="text-section__text">{{ paragraph }}</p>
    {% endfor %}
  </div>
</section>

<section class="landing-section">
  <div class="content-column">
    <h2 class="faq__title">{{ (d ~ ".faq.title") | t(lang) }}</h2>
    <div class="faq">
    {% for item in (d ~ ".faq.items") | t(lang) %}
    <details class="faq__item">
      <summary class="faq__question">{{ item.question }}</summary>
      <p class="faq__answer">{{ item.answer }}</p>
    </details>
    {% endfor %}
  </div>
  </div>
</section>

<section class="landing-section">
  <div class="text-section content-column">
    <h2 class="text-section__title">{{ (d ~ ".guide.title") | t(lang) }}</h2>
    <p class="text-section__text">{{ (d ~ ".guide.text") | t(lang) }}</p>
    <div class="text-section__actions">
      <a class="button-secondary" href="/{{ lang }}/apps/6-jars-finance/articles/guide/">{{ (d ~ ".guide.button") | t(lang) }}</a>
    </div>
  </div>
</section>

<section class="landing-section">
  <div class="app-cta">
    <div class="app-cta__content">
      <h2 class="app-cta__title">{{ (d ~ ".cta.title") | t(lang) }}</h2>
      <p class="app-cta__text">{{ (d ~ ".cta.text") | t(lang) }}</p>
      <div class="app-cta__actions">
      <a
        class="button-store"
        href="{{ playStoreUrl }}"
        rel="noopener noreferrer"
        target="_blank"
        data-analytics-store="google_play"
        data-analytics-placement="final_cta"
      >
        <svg class="button-store__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M3.609 1.814L13.792 12 3.61 22.186a1.2 1.2 0 0 1-.2-.65V2.465a1.2 1.2 0 0 1 .199-.651z"/>
        </svg>
        Google Play
      </a>
      <button
        class="button-store"
        type="button"
        data-open-app-store-modal
        data-analytics-store="app_store"
        data-analytics-placement="final_cta"
      >
        <svg class="button-store__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
        </svg>
        App Store
      </button>
    </div>
    </div>
  </div>
</section>

<div
  class="modal-overlay"
  id="app-store-modal"
  aria-hidden="true"
  hidden
>
  <div
    class="modal{% if waitlistSubscribeButton %} modal--waitlist{% endif %}"
    role="dialog"
    aria-labelledby="app-store-modal-title"
    aria-modal="true"
  >
    {% if waitlistSubscribeButton %}
    <button
      class="modal__close"
      type="button"
      data-close-app-store-modal
      aria-label="{{ (d ~ '.modal.waitlist.closeLabel') | t(lang) }}"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12l-4.89 4.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4z"/>
      </svg>
    </button>
    <div
      class="modal__waitlist"
      data-ios-waitlist
      data-api-url="{{ site.apiBaseUrl }}/waitlist"
      data-msg-invalid="{{ (d ~ '.modal.waitlist.errorInvalidEmail') | t(lang) }}"
      data-msg-error="{{ (d ~ '.modal.waitlist.errorGeneric') | t(lang) }}"
      data-msg-sending="{{ (d ~ '.modal.waitlist.sending') | t(lang) }}"
    >
      <div class="modal__waitlist-form-view" data-ios-waitlist-form-view>
        <h2 class="modal__title" id="app-store-modal-title">{{ (d ~ ".modal.waitlist.title") | t(lang) }}</h2>
        <p class="modal__text modal__text--waitlist">{{ (d ~ ".modal.waitlist.description") | t(lang) }}</p>
        <form class="modal__form" data-ios-waitlist-form novalidate>
          <label class="modal__field">
            <span class="modal__field-label">{{ (d ~ ".modal.waitlist.emailLabel") | t(lang) }}</span>
            <input
              class="modal__input"
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              required
              placeholder="{{ (d ~ '.modal.waitlist.emailPlaceholder') | t(lang) }}"
              data-ios-waitlist-email
            />
          </label>
          <p class="modal__message modal__message--error" data-ios-waitlist-error hidden role="alert"></p>
          <button class="button-primary modal__button-full" type="submit" data-ios-waitlist-submit data-label-default="{{ waitlistSubscribeButton }}">{{ waitlistSubscribeButton }}</button>
        </form>
      </div>
      <div class="modal__waitlist-success" data-ios-waitlist-success hidden>
        <div class="modal__waitlist-icon" aria-hidden="true">
          <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="36" cy="36" r="36" fill="var(--color-brand-soft)"/>
            <path d="M18 26.5l18 12 18-12v19.5a2.5 2.5 0 0 1-2.5 2.5h-31a2.5 2.5 0 0 1-2.5-2.5V26.5z" stroke="var(--color-brand)" stroke-width="2" stroke-linejoin="round"/>
            <path d="M18 26.5 36 38.5l18-12" stroke="var(--color-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="50" cy="22" r="12" fill="var(--color-brand)"/>
            <path d="M45.5 22.5 48.5 25.5l6.5-6.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="modal__title modal__title--success">{{ (d ~ ".modal.waitlist.successTitle") | t(lang) }}</h2>
        <p class="modal__text modal__text--success">{{ (d ~ ".modal.waitlist.successDescription") | t(lang) }}</p>
        <button class="button-primary modal__button-full" type="button" data-close-app-store-modal>{{ (d ~ ".modal.waitlist.successButton") | t(lang) }}</button>
      </div>
    </div>
    {% else %}
    <h2 class="modal__title" id="app-store-modal-title">{{ (d ~ ".modal.title") | t(lang) }}</h2>
    <p class="modal__text">{{ (d ~ ".modal.text") | t(lang) }}</p>
    <div class="modal__actions">
      <button class="button-primary" type="button" data-close-app-store-modal>{{ (d ~ ".modal.button") | t(lang) }}</button>
    </div>
    {% endif %}
  </div>
</div>

<script src="/assets/js/ios-waitlist.js" defer></script>
